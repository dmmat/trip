{
  "name": "trip-planner-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute trip-planner-db --local --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute trip-planner-db --local --file=./src/db/seed.sql",
    "db:migrate:remote": "wrangler d1 execute trip-planner-db --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "wrangler": "^3.60.0"
  }
}
